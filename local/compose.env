# LOCAL-ONLY configuration for the walking slice stack (U0, S1 to S3).
# No secrets: every value is a placeholder or a local address. Never used outside local/.
#
# The fake identity provider's issuer. The API accepts it only because APP_ENV=local (BR1.3);
# the S0 guard reads this value to make sure it never appears in a build output (BR1.2).
APP_ENV=local
AUTH_ISSUER=http://fake-idp.invalid
AUTH_AUDIENCE=portfolio-studio-api
OWNER_SUBJECT=local-owner
FAKE_IDP_TEST_SUBJECTS=local-other
CORS_ORIGIN=http://localhost:5173

# MongoDB single-node replica set (transactions for Publish, REL-0.1).
MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0
MONGO_DB=portfolio_slice

# Publish output and the renderer (paths inside the API container).
SITE_DIR=/site
FIXTURE_DIR=/app/fixtures
RENDERER_COMMAND=node /app/renderer/cli.cjs
RENDERER_ASSETS_DIR=/app/renderer/assets

# Placeholder site identity for the C2 `site` object.
SITE_OWNER_NAME=Placeholder Owner
SITE_GITHUB_URL=https://github.com/example
